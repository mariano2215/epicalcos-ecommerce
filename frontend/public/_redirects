# Espejo de los redirects de netlify.toml (que se aplican primero). Tienen que
# estar acá los MISMOS /api/*: si esta lista queda corta, el fallback SPA de
# abajo se traga el POST y devuelve index.html con status 200 — el checkout
# rompe con un error de JSON imposible de diagnosticar.
/api/create-preference      /.netlify/functions/create-preference      200
/api/create-order-transfer  /.netlify/functions/create-order-transfer  200
/api/capture-lead           /.netlify/functions/capture-lead           200
/api/mercadopago-webhook    /.netlify/functions/mercadopago-webhook    200
/api/track-cart             /.netlify/functions/track-cart             200
/api/unsubscribe            /.netlify/functions/unsubscribe            200

# URLs "bonitas" para anuncios → 301 a la página real (espejo de netlify.toml).
# NO son landings nuevas: /personalizados, /negocio y /mayorista ya existen, así
# que duplicarlas sería contenido duplicado. Las landings que sí son contenido
# nuevo (/calcos-termo, /calcos-notebook, /calcos-auto) las resuelve el SPA.
/calcos-personalizadas   /personalizados  301
/calcos-para-negocios    /negocio         301
/pack-100-calcos         /mayorista       301

# SPA fallback (SIEMPRE al final)
/*  /index.html  200
